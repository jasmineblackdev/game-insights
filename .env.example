# Copy to .env.local and fill the anon key from:
# Supabase Dashboard → Project Settings → API → Project API keys → anon public
# The anon key is a long JWT string (typically 200+ characters), not a short token.
# Do NOT use sb_publishable_... for Edge Functions — use the JWT "anon" key or calls return 401.

VITE_SUPABASE_URL=https://rxnqjdclqyazferbseeq.supabase.co
VITE_SUPABASE_ANON_KEY=

# --- Vercel / Netlify / CI (production site shows "Preview" until this is done) ---
# Add the SAME two variables in the host's Environment Variables UI for Production (and Preview).
# Trigger a new deployment after saving. Vite only embeds VITE_* at build time — runtime env alone is not enough.

# Optional overrides (see src/vite-env.d.ts)
# VITE_DRAFT_EDGE_API_URL=
# VITE_NBA_STATS_PROXY_URL=
# VITE_PLAYER_EDGE_API_URL=

# --- The Odds API (https://the-odds-api.com) ---
# Recommended: server-only key — never shipped to the browser.
# Local dev: add to .env.local → Vite proxies /__odds-api → the-odds-api.com (see vite.config.ts).
# Production: set Supabase secret THE_ODDS_API_KEY and deploy Edge Function `odds-api-proxy`.
# THE_ODDS_API_KEY=
#
# Legacy (key is embedded in the client bundle at build time — avoid if you can):
# VITE_THE_ODDS_API_KEY=
#
# Optional: full URL to odds-api-proxy (default: VITE_SUPABASE_URL/functions/v1/odds-api-proxy)
# VITE_ODDS_API_PROXY_URL=
#
# Optional: pin NFL draft outrights sport key if /sports discovery misses it
# VITE_THE_ODDS_API_NFL_DRAFT_SPORT_KEY=

# Optional: https://www.football-data.org — EPL table + 7/14-day finished-match congestion (free tier signup)
# Dev server proxies /football-data-api so the token is not sent from the browser bundle.
# VITE_FOOTBALL_DATA_API_TOKEN=
